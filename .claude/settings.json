{
  "extraKnownMarketplaces": {
    "riverhead-local": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "enabledPlugins": {
    "autoharness@riverhead-local": true,
    "document-skills@anthropic-agent-skills": true
  },
  "env": {
    "AUTOHARNESS_DISABLE_GLOBAL": "1",
    "AUTOHARNESS_REFLECT_EVERY_N": "50",
    "AUTOHARNESS_CONSOLIDATE_EVERY_N": "250"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-push.py\""
          }
        ]
      }
    ]
  }
}
